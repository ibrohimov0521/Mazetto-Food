NODE_ENV=development

# Backend
BACKEND_PORT=4000
DATABASE_URL=postgresql://mazetto:mazetto@localhost:5432/mazetto
# Backend oldida turgan ISHONCHLI proxy soni.
# 0 (default) — hech qanday proxy header'iga ishonilmaydi, TCP peer manzili
#   ishlatiladi. Lokal ishlab chiqish uchun to'g'ri qiymat.
# Ishlab chiqarish: Cloudflare -> Dokploy/Traefik -> backend, ya'ni 2.
# Bu qiymat origin to'g'ridan-to'g'ri ochiq bo'lmaganda ishonchli.
TRUSTED_PROXY_HOP_COUNT=0

# Ruxsat etilgan Origin'lar, vergul bilan. Berilmasa ishlab chiqish
# default'i ishlatiladi (hozirgi ishlab chiqarish qiymatlari bilan bir xil).
# HTTP CORS va WebSocket CORS ikkalasi ham shu ro'yxatdan oziqlanadi.
# `*` qabul qilinmaydi — `credentials: true` bilan brauzer uni rad etadi.
CORS_ORIGIN=

JWT_ACCESS_SECRET=change-me-in-real-environments
JWT_REFRESH_SECRET=change-me-in-real-environments
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
CUSTOMER_JWT_ACCESS_SECRET=change-me-in-real-environments
CUSTOMER_JWT_REFRESH_SECRET=change-me-in-real-environments
CUSTOMER_JWT_ACCESS_EXPIRES_IN_SECONDS=900
CUSTOMER_JWT_REFRESH_EXPIRES_IN_SECONDS=604800
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-in-real-environments
TELEGRAM_CUSTOMER_BOT_URL=
TELEGRAM_BOT_URL=

# One-time local/container staff owner bootstrap. Leave empty unless intentionally running staff:bootstrap.
MAZETTO_BOOTSTRAP_ADMIN_EMAIL=
MAZETTO_BOOTSTRAP_ADMIN_PHONE=
MAZETTO_BOOTSTRAP_ADMIN_PASSWORD=
MAZETTO_BOOTSTRAP_ADMIN_NAME=MAZETTO Owner
MAZETTO_BOOTSTRAP_ADMIN_BRANCH=
MAZETTO_BOOTSTRAP_ADMIN_ACTIVATE=0

# Frontend build/runtime
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_MEDIA_URL=http://localhost:8080

# Local docker-compose PostgreSQL service
POSTGRES_USER=mazetto
POSTGRES_PASSWORD=mazetto
POSTGRES_DB=mazetto
# Docker konteyneri host'da qaysi portda ochilsin.
# 5432/6379 band bo'lsa (masalan boshqa loyiha yoki Windows servisi),
# shu yerda o'zgartiring va DATABASE_URL ni ham moslang.
POSTGRES_PORT=5432
REDIS_PORT=6379
