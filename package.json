{
  "name": "mazetto-food",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "media:prepare": "node apps/media/scripts/prepare-media-release.mjs --dry-run",
    "media:smoke": "node apps/media/scripts/smoke-media-container.mjs",
    "media:validate": "node apps/media/scripts/validate-media-assets.mjs",
    "format": "prettier --write .",
    "test": "turbo run test",
    "ci": "DATABASE_URL=${DATABASE_URL:-postgresql://ci:ci@localhost:5432/ci} pnpm --filter backend prisma:generate && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm validate",
    "load:test": "node scripts/load-test.mjs",
    "verify": "turbo run typecheck lint && turbo run build && node scripts/ops-validate.mjs",
    "validate": "node scripts/ops-validate.mjs",
    "db:backup": "node scripts/ops-backup-db.mjs",
    "db:rehearse-restore": "node scripts/rehearse-database-restore.mjs",
    "ops:health": "node scripts/ops-health.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:smoke": "node scripts/smoke-production.mjs",
    "telegram:smoke": "node scripts/smoke-telegram-production.mjs",
    "release:acceptance": "node scripts/release-acceptance.mjs",
    "qa:customer": "node scripts/qa-customer-contrast.mjs",
    "qa:role-matrix": "node scripts/qa-authenticated-role-matrix.mjs",
    "qa:isolated-order-e2e": "node scripts/isolated-order-e2e.mjs",
    "desktop:dev": "pnpm --filter mazetto-desktop dev",
    "desktop:package:dir": "pnpm --filter mazetto-desktop package:dir",
    "desktop:package:win": "pnpm --filter mazetto-desktop package:win"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "turbo": "2.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0"
  }
}
