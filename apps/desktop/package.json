{
  "name": "mazetto-desktop",
  "version": "0.1.24",
  "description": "MAZETTO FOOD offline-first branch operations desktop",
  "author": "MAZETTO FOOD",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "dev:bundled": "pnpm build && pnpm build:ui && electron . --bundled-ui",
    "build": "tsc -p tsconfig.json",
    "build:ui": "node scripts/prepare-ui.mjs",
    "package:dir": "pnpm build && pnpm build:ui && electron-builder --dir",
    "package:win": "pnpm build && pnpm build:ui && electron-builder --win nsis",
    "start": "electron .",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "uz.mazetto.desktop",
    "productName": "MAZETTO Desktop",
    "artifactName": "MAZETTO-Desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/pos-web",
        "to": "ui"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeader": "resources/installer-header.bmp",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/ibrohimov0521/Mazetto-Food/releases/latest/download/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
